# =====================================
# AWS Configuration
# =====================================
# AWS Profile from ~/.aws/credentials
# Run: aws configure --profile cyberbuddy-dev
AWS_PROFILE=cyberbuddy-dev
AWS_REGION=us-east-1

# =====================================
# Environment (dev/staging/prod)
# =====================================
ENVIRONMENT=dev

# =====================================
# Google AI API Key (for pet generation)
# Get from: https://makersuite.google.com/app/apikey
# =====================================
GOOGLE_AI_API_KEY=
