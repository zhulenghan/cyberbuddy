{
  "extends": "../shared/tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "rootDir": "./",
    "paths": {
      "@/*": ["./"],
      "@/components/*": ["./components/*"],
      "@/hooks/*": ["./hooks/*"],
      "@/utils/*": ["./utils/*"],
      "@/lib/*": ["./lib/*"],
      "@/pages/*": ["./pages/*"],
      "@/assets/*": ["./assets/*"],
      "@shared/*": ["../shared/*"]
    }
  },
  "include": [
    "entrypoints/**/*",
    "components/**/*",
    "pages/**/*",
    "hooks/**/*",
    "utils/**/*",
    "lib/**/*",
    "assets/**/*"
  ],
  "exclude": ["node_modules", ".output", ".wxt"]
}
